{
  "name": "Dreikanterbot",
  "short_name": "Dreikanter",
  "description": "自带模型 Key 的私人工作台：长上下文对话、记忆库、插件、文件导入与多端同步。",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f2f0ea",
  "theme_color": "#b4472f",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "新建对话",
      "short_name": "新对话",
      "url": "/?new=1",
      "description": "打开一个新的对话"
    },
    {
      "name": "继续 DeepSeek 对话",
      "short_name": "继续对话",
      "url": "/?import=1",
      "description": "导入 DeepSeek 官方对话并继续聊"
    }
  ]
}
