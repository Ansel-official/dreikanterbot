# =============================================================================
# Dreikanterbot 环境变量模板
# 使用方法：cp .env.example .env 后逐项填写；生产环境务必更换所有占位密码。
# =============================================================================

# ---------- 必填：安全 ----------
# V3 默认 BYOK：每个用户在「设置 → AI 接入」里填写自己的 Key。
# 下面的服务端 Key 是可选的兜底，只有 ALLOW_SERVER_KEY_FALLBACK=true 时才会被使用。
DEEPSEEK_API_KEY=
ALLOW_SERVER_KEY_FALLBACK=false
# JWT 签名密钥。生成方式：openssl rand -hex 32
# deploy.sh 检测到占位值时会自动生成并写回 .env
SECRET_KEY=please-generate-with-openssl-rand-hex-32

# ---------- 数据库 / 缓存 ----------
# 本地开发（直接跑 uvicorn）时连接 127.0.0.1；docker compose 会自动覆盖为容器内地址
DATABASE_URL=postgresql://chatbot:change-me-strong@db:5432/chatbot
REDIS_URL=redis://redis:6379/0

# docker compose 的 PostgreSQL 初始化参数（POSTGRES_PASSWORD 必须与 DATABASE_URL 中的密码一致）
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=chatbot

# ---------- 应用 ----------
APP_NAME=Dreikanterbot
ENVIRONMENT=production
APP_PORT=80
# 启用 docker-compose.https.yml（源站 443）时使用
HTTPS_PORT=443
# 逗号分隔的允许来源；生产环境改成你的 Cloudflare 域名
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://chat.example.com
# 可选：限定 Host 头，留空则不启用；生产建议填域名，例如 chat.example.com
ALLOWED_HOSTS=
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# ---------- 鉴权 ----------
ACCESS_TOKEN_EXPIRE_DAYS=30
# 首次启动引导管理员：users 表没有任何 admin 时自动创建。
# 建好后建议把 ADMIN_PASSWORD 清空，避免密码长期留在 .env。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-123456
# 允许 /api/auth/bootstrap 在系统无用户时创建第一个管理员（首次部署后可设为 false）
ALLOW_BOOTSTRAP=true
# 可选的一次性引导令牌；设置后调用 bootstrap 必须带 X-Bootstrap-Token 头
BOOTSTRAP_TOKEN=

# ---------- 配额（每日，按自然日，Redis 计数） ----------
GUEST_DAILY_LIMIT=100
MEMBER_DAILY_LIMIT=1000

# ---------- 模型默认值 ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=393216
DEEPSEEK_REASONER_MAX_TOKENS=393216
DEEPSEEK_TEMPERATURE=1.0
# 上下文按 token 预算；DeepSeek V4 / Kimi K3 官方 1M，自定义网关最高 2M。
DEFAULT_CONTEXT_WINDOW=1048576
MAX_CONTEXT_WINDOW=2000000

# 月之暗面 Kimi（可选服务端兜底）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_REASONER_MODEL=kimi-k3.1-pro
SYSTEM_PROMPT=你是 Dreikanterbot，一名严谨、友好的 AI 助手。请使用简体中文回答，表达准确、简洁、可执行；涉及代码时给出完整可运行的示例，并说明关键步骤。不要编造不确定的事实。

# ---------- 文件导入 ----------
MAX_FILE_MB=100
MAX_FILE_TEXT_CHARS=2000000
MAX_ATTACHMENT_COUNT=10
MAX_IMPORT_MB=100

# ---------- 记忆库 / 个人云端 ----------
MEMORY_DIR=./data/memory
MAX_MEMORY_MB=100
MAX_MEMORY_TOTAL_MB=4096
MAX_MEMORY_TEXT_CHARS=2000000
WEBDAV_TIMEOUT_SECONDS=60

# ---------- 声明式插件 ----------
PLUGIN_DIR=./data/plugins
MAX_PLUGIN_MB=10
MAX_PLUGIN_FILES=80
MAX_PLUGIN_PROMPTS=50

# ---------- 语音转文字（本地 Whisper） ----------
# auto: 优先 faster-whisper，其次 openai-whisper；也可显式指定 faster / openai / disabled
ASR_ENGINE=auto
ASR_MODEL=base
ASR_LANGUAGE=zh
MAX_AUDIO_MB=20
ASR_TIMEOUT_SECONDS=180
WHISPER_CACHE_DIR=/models/whisper
# 国内服务器下载模型慢时启用 HuggingFace 镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------- 前端构建 ----------
# 前端默认同源请求 /api，一般无需修改
VITE_API_BASE=/api
